org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
android.nonTransitiveRClass=true
kotlin.code.style=official
org.gradle.caching=true

# Miuix (HyperOS design system) version, used by the gallery module.
miuixVersion=0.9.4

# Parallel project execution is off: this machine resolves dependencies through a transparent
# HTTP proxy that drops TLS handshakes when too many connections are opened at once, and the
# resulting "Remote host terminated the handshake" failures are not real dependency problems.
org.gradle.parallel=false

# Network configuration is handled per-environment. The CI runner has direct access.