package com.mouya.LiquidFrame

import android.content.Context
import de.robv.android.xposed.XposedBridge
import java.lang.reflect.Method

/**
 * Helper for discovering obfuscated classes and methods using reflection.
 * DexKit was removed due to AGP 9 compatibility issues; this uses XposedHelpers
 * fallback paths instead, which are sufficient for the known camera versions.
 */
object DexKitHelper {

    private var cachedClassLoader: ClassLoader? = null

    fun init(context: Context) {
        // No-op: DexKit was removed. Initialisation is unnecessary.
    }

    fun setClassLoader(loader: ClassLoader) {
        cachedClassLoader = loader
    }

    /**
     * Find the canvas wrapper class. Returns null — callers should use the
     * hardcoded fallback path (pe.o) directly.
     */
    fun findCanvasWrapper(): Class<*>? = null

    /**
     * Find the composite method. Returns null — callers should use the
     * hardcoded fallback path (Fe.a->j) directly.
     */
    fun findCompositeMethod(loader: ClassLoader): Method? = null

    /**
     * Find the drawRect wrapper method.
     */
    fun findDrawRectMethod(canvasWrapperClass: Class<*>): Method? = null
}