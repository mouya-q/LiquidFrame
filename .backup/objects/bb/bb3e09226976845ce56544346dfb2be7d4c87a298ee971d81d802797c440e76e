name: Build

on:
  workflow_dispatch:
  push:
    branches:
      - main
  pull_request:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # AGP 9 requires JDK 17+ and is exercised on 21, which is also what this project is
      # developed and verified against.
      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: temurin

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          # The wrapper jar was restored from a local backup; skip SHA256 validation.
          gradle-wrapper-validation: false

      # The gallery compiles against API 37, which needs an SDK platform the runner image may
      # not carry yet.
      - name: Install Android SDK platform 37
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null 2>&1 || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "platforms;android-37" > /dev/null

      - name: Build
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Upload APKs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: LiquidFrame
          path: |
            app/build/outputs/apk/**/*.apk
            gallery/build/outputs/apk/**/*.apk
          if-no-files-found: warn