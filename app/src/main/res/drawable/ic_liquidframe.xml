<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass style launcher icon, drawn entirely in XML vector. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Base squircle background -->
    <path android:pathData="M128,0 L384,0 C461,0 512,51 512,128 L512,384 C512,461 461,512 384,512 L128,512 C51,512 0,461 0,384 L0,128 C0,51 51,0 128,0 Z"
          android:fillColor="#0A0A0E" />

    <!-- Glass capsule: a rounded-rect that reads as a frosted glass pill -->
    <path android:pathData="M96,316 C96,280 124,256 158,256 L354,256 C388,256 416,280 416,316 C416,352 388,376 354,376 L158,376 C124,376 96,352 96,316 Z"
          android:fillColor="#1A1A2E" />

    <!-- Inner glass highlight (top half of capsule) -->
    <path android:pathData="M112,316 C112,290 134,272 160,272 L352,272 C378,272 400,290 400,316 L112,316 Z"
          android:fillColor="#3D3D5C" android:fillAlpha="0.5" />

    <!-- Specular highlight band -->
    <path android:pathData="M128,300 C140,288 380,288 384,296 C388,304 384,312 372,316 L140,316 C128,312 120,308 128,300 Z"
          android:fillColor="#FFFFFF" android:fillAlpha="0.12" />

    <!-- Rim light: thin bright stroke along the top edge of the capsule -->
    <path android:pathData="M108,314 C112,282 136,262 158,262 L354,262 C376,262 400,282 404,314"
          android:strokeColor="#7AC4FF" android:strokeWidth="3" android:strokeLineCap="round"
          android:fillColor="@android:color/transparent" />

    <!-- Refraction glow at left edge -->
    <path android:pathData="M100,320 C100,296 114,278 132,270"
          android:strokeColor="#A8D8FF" android:strokeWidth="6" android:strokeLineCap="round"
          android:fillColor="@android:color/transparent" android:strokeAlpha="0.3" />

    <!-- Chromatic aberration hint: subtle color split at right edge -->
    <path android:pathData="M412,320 C412,296 398,278 380,270"
          android:strokeColor="#FF6B6B" android:strokeWidth="2" android:strokeLineCap="round"
          android:fillColor="@android:color/transparent" android:strokeAlpha="0.15" />

    <!-- Center content dot (the "shutter" of the glass capsule) -->
    <path android:pathData="M246,310 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"
          android:fillColor="#4A9FFF" android:fillAlpha="0.8" />
    <path android:pathData="M246,306 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
          android:fillColor="#7AC4FF" android:fillAlpha="0.9" />

    <!-- Outer ambient glow -->
    <path android:pathData="M128,0 L384,0 C461,0 512,51 512,128 L512,384 C512,461 461,512 384,512 L128,512 C51,512 0,461 0,384 L0,128 C0,51 51,0 128,0 Z"
          android:strokeColor="#2A2A3E" android:strokeWidth="1"
          android:fillColor="@android:color/transparent" />

</vector>