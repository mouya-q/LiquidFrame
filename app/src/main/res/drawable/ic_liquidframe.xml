    <!-- Final Glass Shine -->
    <!-- ========================= -->


    <path
        android:pathData="
        M110,150

        C180,120
        260,130
        400,150"

        android:strokeColor="#55FFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>



    <path
        android:pathData="
        M120,390

        C220,420
        320,410
